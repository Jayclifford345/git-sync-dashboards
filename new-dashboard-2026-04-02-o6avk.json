     align-items: center;\n                                   justify-content: center;\n                                   font-weight: 700;\n                                   font-size: 0.88rem;\"\u003e2\u003c/div\u003e\n                        \u003cdiv style=\"font-weight: 700; font-size: 0.95rem; color: #2C2C2C; line-height: 1.3;\"\u003eUpdate Metrics\u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n                \n                \u003c!-- Step 3 --\u003e\n                \u003cdiv style=\"background: rgba(255, 255, 255, 0.08);\n                            color: #2C2C2C;\n                            padding: 12px;\n                            border-radius: 10px;\n                            border: 1px solid rgba(255, 255, 255, 0.15);\n                            flex: 1;\n                            min-width: 0;\n                            display: flex;\n                            flex-direction: column;\n                            min-height: 50px;\"\u003e\n                    \u003cdiv style=\"display: flex; align-items: flex-start; gap: 8px;\"\u003e\n                        \u003cdiv style=\"background: white;\n                                   color: #2C2C2C;\n                                   width: 24px;\n                                   height: 24px;\n                                   min-width: 24px;\n                                   flex-shrink: 0;\n                                   border-radius: 6px;\n                                   display: flex;\n                                   align-items: center;\n                                   justify-content: center;\n                                   font-weight: 700;\n                                   font-size: 0.88rem;\"\u003e3\u003c/div\u003e\n                        \u003cdiv style=\"font-weight: 700; font-size: 0.95rem; color: #2C2C2C; line-height: 1.3;\"\u003eUpdate \u0026 Test Queries\u003c/div\u003e\n                    \u003c/div\